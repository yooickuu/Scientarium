# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Canonical HTTPS address, required for a public launch.
APP_ORIGIN=
# Local SQLite only. Serverless hosting needs an external database integration.
DATABASE_PATH=./data/medevents.db

# Protected developer/owner email; private server setting.
OWNER_EMAIL=

# Browser-safe Supabase settings. NEVER use a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Empty for existing local SQLite preview; set supabase only after import.
NEXT_PUBLIC_DATA_BACKEND=
# GitHub project path; blank for a custom domain.
NEXT_PUBLIC_BASE_PATH=
